# ── Databricks bundle state ─────────────────────────────────────────────────
# .databricks/ contains Terraform state with workspace-specific resource IDs
# (pipeline IDs, job IDs, etc.). It MUST NOT be committed — it would cause
# "resource not found" errors on any workspace other than the one it was
# deployed from. Delete this directory to force a clean deploy on a new workspace.
.databricks/

# Local workspace overrides (host URL, catalog, warehouse ID)
# See databricks.local.yml.example for the template
databricks.local.yml

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store

# ── Secrets / env ────────────────────────────────────────────────────────────
.env
*.env.local
