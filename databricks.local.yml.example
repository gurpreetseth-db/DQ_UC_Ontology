# databricks.local.yml — YOUR workspace overrides
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to databricks.local.yml and fill in your values.
# databricks.local.yml is gitignored — it never gets committed.
#
# It is included by databricks.yml via the `include` directive, so DABs
# picks it up automatically — no flag needed.
# ─────────────────────────────────────────────────────────────────────────────

targets:
  dev:
    workspace:
      host: https://YOUR-WORKSPACE.cloud.databricks.com   # <-- change this
      profile: your-cli-profile-name                      # optional: ~/.databrickscfg profile
    variables:
      catalog:      your_catalog_name      # must already exist in your workspace
      warehouse_id: your_warehouse_id      # SQL Warehouses → <name> → Connection Details
      owner_user:   your.email@company.com # user who gets unmasked PII access

  prod:
    workspace:
      host: https://YOUR-PROD-WORKSPACE.cloud.databricks.com  # optional
      profile: your-prod-profile
    variables:
      catalog: your_prod_catalog
      warehouse_id: your_prod_warehouse_id
