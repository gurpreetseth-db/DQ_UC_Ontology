@prefix nr:   <https://nexusretail.databricks.com/ontology#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

################################################################################
# NexusRetail SHACL shapes — reasoning / validation over the knowledge graph
#
# WHERE THIS RUNS IN ONTOBRICKS
#   • Import this file:  Sidebar → Ontology → Data Quality → Import
#   • Run validation:    Sidebar → Knowledge Graph → Data Quality → Run Validation
#     (each shape is compiled to SQL and executed against the triple-store view;
#      the graph must be built first).
#
# IMPORTANT — TWO KINDS OF SHAPE IN THIS FILE
#   OntoBricks' SHACL engine is category-based and compiles every shape to SQL.
#
#   SECTION A — Property-constraint shapes (sh:property + minCount / datatype /
#   class). These IMPORT and SCORE cleanly (real pass/fail rates).
#
#   SECTION B — Conditional narrative shapes (the faulty-batch story). These are
#   inherently "IF … THEN …" rules. OntoBricks supports them as CONDITIONAL
#   conformance/consistency shapes, but **it does not reconstruct the IF block on
#   file import** (a plain import brings the constraint back unguarded). So the
#   reliable way to get these is to BUILD THEM IN THE UI with "Add Shape" using
#   the recipes documented in the comments below. The standard SHACL-SPARQL
#   forms are kept here for reference / other SHACL engines; on import into
#   OntoBricks they will show an info icon (no pass rate) rather than score.
################################################################################

# =============================================================================
# SECTION A — Importable, self-scoring property shapes
# =============================================================================

# ── Shape A1: invoice reconciliation quality ──────────────────────────────────
# Graph-level restatement of the DQX invoice_total_null rule: every Invoice must
# carry a total (NULLs were dropped at silver) and a reconciliation flag.
nr:InvoiceQualityShape
    a sh:NodeShape ;
    rdfs:label "Invoice completeness" ;
    sh:targetClass nr:Invoice ;
    sh:property [
        sh:path nr:invoiceTotal ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "Invoice has no invoiceTotal — should have been dropped/quarantined at silver." ;
    ] ;
    sh:property [
        sh:path nr:totalReconciled ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:severity sh:Warning ;
        sh:message "Invoice missing reconciliation flag." ;
    ] .

# ── Shape A2: order structural completeness ───────────────────────────────────
# Every Order must be attributable to a Customer and shipped to a Region — the
# two edges every downstream cohort/traversal query relies on.
nr:OrderStructureShape
    a sh:NodeShape ;
    rdfs:label "Order structural completeness" ;
    sh:targetClass nr:Order ;
    sh:property [
        sh:path nr:placedBy ;
        sh:minCount 1 ;
        sh:class nr:Customer ;
        sh:severity sh:Violation ;
        sh:message "Order has no placedBy Customer — orphaned order." ;
    ] ;
    sh:property [
        sh:path nr:orderShippedToRegion ;
        sh:minCount 1 ;
        sh:class nr:Region ;
        sh:severity sh:Violation ;
        sh:message "Order has no shipping Region — cannot be placed on the geographic traversal." ;
    ] .

# ── Shape A3: return completeness ─────────────────────────────────────────────
# Every Return must carry a reason code — the field the whole Returns & Quality
# subdomain slices on.
nr:ReturnCompletenessShape
    a sh:NodeShape ;
    rdfs:label "Return completeness" ;
    sh:targetClass nr:Return ;
    sh:property [
        sh:path nr:returnReasonCode ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Return has no reason code." ;
    ] .

# =============================================================================
# SECTION B — Conditional narrative shapes (BUILD THESE VIA "Add Shape")
#
# These carry the faulty-batch story. Recreate each one in
# Ontology → Data Quality → Add Shape so the IF block compiles to SQL:
#
#   ┌─ Shape B1: Faulty-product return integrity ───────────────────────────────┐
#   │  Category    : Conformance                                                 │
#   │  Target Class: Return                                                      │
#   │  IF (condition): returnReasonCode  =  "faulty_product"                     │
#   │  THEN         : faultyBatchInvolved  hasValue  true   (boolean)            │
#   │  Severity     : Violation                                                  │
#   │  Message      : "Return coded faulty_product but faultyBatchInvolved is    │
#   │                  not true — reason code and batch evidence disagree."      │
#   └────────────────────────────────────────────────────────────────────────────┘
#
#   ┌─ Shape B2: Batch membership consistency ──────────────────────────────────┐
#   │  Category    : Consistency                                                 │
#   │  Target Class: Product                                                     │
#   │  IF (condition): faultyBatch  =  true                                      │
#   │  THEN         : memberOfBatch  minCount  1   (relationship must exist)     │
#   │  Severity     : Warning                                                    │
#   │  Message      : "Faulty product not linked to a FaultyBatch node —         │
#   │                  mapping drift (only the 8 FAULT-PHON-* SKUs should link)."│
#   └────────────────────────────────────────────────────────────────────────────┘
#
# The reference SHACL-SPARQL forms below are equivalent for a standards SHACL
# engine; OntoBricks lists them with an info icon (no pass rate) on import, which
# is why the UI recipes above are the reliable path.
# =============================================================================

<https://nexusretail.databricks.com/ontology>
    sh:declare [
        sh:prefix "nr" ;
        sh:namespace "https://nexusretail.databricks.com/ontology#"^^xsd:anyURI ;
    ] .

# ── Shape B1 (reference SPARQL form) ──────────────────────────────────────────
nr:FaultyProductReturnShape
    a sh:NodeShape ;
    rdfs:label "Faulty-product return integrity (reference)" ;
    sh:targetClass nr:Return ;
    sh:sparql [
        sh:message "Return coded 'faulty_product' but faultyBatchInvolved is not true." ;
        sh:prefixes <https://nexusretail.databricks.com/ontology> ;
        sh:select """
            SELECT $this
            WHERE {
                $this nr:returnReasonCode "faulty_product" .
                FILTER NOT EXISTS { $this nr:faultyBatchInvolved true }
            }
        """ ;
    ] .

# ── Shape B2 (reference SPARQL form) ──────────────────────────────────────────
nr:BatchMembershipShape
    a sh:NodeShape ;
    rdfs:label "Batch membership consistency (reference)" ;
    sh:targetClass nr:Product ;
    sh:sparql [
        sh:message "Product faultyBatch=true but not linked to a FaultyBatch node (or the reverse) — mapping/flag mismatch." ;
        sh:prefixes <https://nexusretail.databricks.com/ontology> ;
        sh:select """
            SELECT $this
            WHERE {
                { $this nr:faultyBatch true . FILTER NOT EXISTS { $this nr:memberOfBatch ?b } }
                UNION
                { $this nr:memberOfBatch ?b . FILTER NOT EXISTS { $this nr:faultyBatch true } }
            }
        """ ;
    ] .
